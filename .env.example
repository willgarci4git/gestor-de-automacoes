# --- Servidor ---
PORT=3000
TENANT_ID=clinica
LOG_LEVEL=info                 # debug | info | warn | error
ADMIN_TOKEN=troque-este-token  # protege /admin, /handoff, /metrics e o console /agent
DB_PATH=./data/bot.db          # ":memory:" para testes rápidos
FLOWS_DIR=./flows
TENANTS_DIR=./tenants
TZ_NAME=America/Sao_Paulo

# --- Fallback global (erros, loops, tentativas esgotadas sem rota) ---
FALLBACK_MESSAGE=Desculpe, tive um problema por aqui. Vou te encaminhar para nossa equipe.
FALLBACK_QUEUE=geral           # vazio = apenas encerra, sem transbordo

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# --- Instagram (DM + gatilho por comentário) ---
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_COMMENT_PUBLIC_REPLY=Te chamei no direct! 📩
# INSTAGRAM_GRAPH_BASE_URL=https://graph.instagram.com  (se usar Instagram API with Instagram Login)

# --- Telegram (opcional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Segredos usados nos fluxos: {{secrets.nome}} -> SECRET_NOME ---
SECRET_LEADS_WEBHOOK_URL=https://script.google.com/macros/s/SEU_ID/exec
