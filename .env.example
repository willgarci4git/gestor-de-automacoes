# --- Servidor ---
PORT=3000
TENANT_ID=clinica
LOG_LEVEL=info                 # debug | info | warn | error
ADMIN_TOKEN=                   # OBRIGATÓRIO: 32+ caracteres aleatórios (openssl rand -hex 32). Protege /admin, /handoff, /metrics
# ALLOW_INSECURE_DEV=1         # só desenvolvimento local sem token: sobe em 127.0.0.1 com /admin aberto
# HOST=0.0.0.0
# HTTP_REQUEST_TIMEOUT_MS=30000
# HTTP_HEADERS_TIMEOUT_MS=15000
# HTTP_MAX_CONNECTIONS=500
DB_PATH=./data/bot.db          # ":memory:" para testes rápidos
FLOWS_DIR=./flows
TENANTS_DIR=./tenants
TZ_NAME=America/Sao_Paulo

# --- Fallback global (erros, loops, tentativas esgotadas sem rota) ---
FALLBACK_MESSAGE=Desculpe, tive um problema por aqui. Vou te encaminhar para nossa equipe.
FALLBACK_QUEUE=geral           # vazio = apenas encerra, sem transbordo

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# --- Instagram (DM + gatilho por comentário) ---
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_COMMENT_PUBLIC_REPLY=Te chamei no direct! 📩
# INSTAGRAM_GRAPH_BASE_URL=https://graph.instagram.com  (se usar Instagram API with Instagram Login)

# --- Telegram (opcional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Integrações HTTP dos fluxos (proteção SSRF) ---
# Hosts permitidos, separados por vírgula; aceita curinga "*.dominio.com". Obrigatório em produção.
INTEGRATION_ALLOWED_HOSTS=script.google.com,script.googleusercontent.com
# INTEGRATION_ALLOW_PRIVATE_NETWORK=1  # só testes locais com destinos em localhost; ignorado em produção

# --- Segredos usados nos fluxos: {{secrets.nome}} -> SECRET_NOME ---
SECRET_LEADS_WEBHOOK_URL=https://script.google.com/macros/s/SEU_ID/exec
